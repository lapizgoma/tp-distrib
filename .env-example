# Docker Compose services connect to the MySQL container by service name
DB_HOST=mysql
DB_PORT=3306
DB_NAME=museo_virtual
DB_USER=root
DB_PASSWORD=root
JWT_SECRET=dev-only-secret-key-change-me-please-0123456789
JWT_ISSUER=museo-virtual
JWT_EXPIRATION=3600

# gRPC services
GRPC_WORKS_PORT=50051
GRPC_EVENTS_PORT=50052
GRPC_USERS_PORT=50053
GRPC_MAX_WORKERS=10
DB_POOL_SIZE=5
ROOM_TRANSITION_MINUTES=5