# Solo para ejecutar este servicio fuera de Docker.
# En Docker, las variables se toman del .env de la raíz.

# gRPC server
GRPC_PORT=50051
GRPC_MAX_WORKERS=10

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=museo_virtual
DB_USER=root
DB_PASSWORD=root
DB_POOL_SIZE=5

# Tour planning
ROOM_TRANSITION_MINUTES=5
